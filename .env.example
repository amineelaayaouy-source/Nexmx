# --- Auth ---
ADMIN_PASSWORD=
JWT_SECRET=

# --- Shopify manual auth (MVP, single store) ---
# When BOTH of these are set, the app talks to this one store using the Admin API
# token directly and the OAuth flow is bypassed. Unset them to fall back to the
# OAuth-stored credentials. The token is server-side only and is never sent to
# the browser. NEVER commit a real value.
SHOPIFY_STORE_DOMAIN=dfpeny-xr.myshopify.com
# Admin API access token from the store's custom app ("shpat_..."). Needs the
# same scopes listed in SHOPIFY_SCOPES below.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Database (Turso / libSQL) ---
# Required in any deployed environment: the Vercel filesystem is read-only, so
# the local data/engine.db SQLite file cannot be used for persistence there.
# Leave both empty for local development to use data/engine.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Shopify OAuth (custom/public app) ---
# From the Shopify app's "Client credentials" / API credentials page
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Canonical public origin of this app, NO trailing slash. Must match the app URL
# configured in Shopify. Callback whitelisted in Shopify = $SHOPIFY_APP_URL/api/shopify/callback
SHOPIFY_APP_URL=https://nexmx.vercel.app
# Comma-separated, no spaces. Must match the scopes requested by the Shopify app.
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_customers

# --- AI providers ---
# One OpenRouter key routes to Claude, GPT and Gemini. Used by the product
# analysis engine (/api/ai/analyze). Read server-side only and never returned to
# the browser. If set here it takes precedence over the value saved in Settings.
OPENROUTER_API_KEY=
HIGGSFIELD_API_KEY=
